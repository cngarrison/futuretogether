# Future Together — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# See supabase/SUPABASE.md §4 for usage rules.

# --- Supabase ---
# Find these in the Supabase dashboard: Settings → API

# Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key — safe for client-side use; RLS enforced
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key — SERVER-SIDE ONLY; bypasses RLS — treat as root credential
# Never use in islands, client JS, or any browser-reachable code
SUPABASE_SECRET_KEY=sb_secret_...

# --- Resend (email) ---
# Find at: resend.com → API Keys
RESEND_API_KEY=re_...

# Sending domain (verified in Resend)
RESEND_FROM_DOMAIN=futuretogether.community

# --- App ---
# Local dev: http://localhost:8000
# Production: https://futuretogether.community
APP_URL=http://localhost:8000

# Deployment environment
# Set to 'production' ONLY in the production Deno Deploy environment.
# Leave unset (or set to anything else) in local dev, staging, and branch previews.
# Controls whether cron jobs (reminder emails) are registered at startup.
APP_ENV=
